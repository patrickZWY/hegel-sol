/target

# Example databases. The default path is <root>/.hegel/examples, so this has to
# match at any depth rather than only at the repository root.
.hegel/

# Foundry build output, one pair per Foundry project.
/solidity/out
/solidity/cache
/examples/out
/examples/cache
/benchmarks/out
/benchmarks/cache
/crates/tests-integration/projects/*/out
/crates/tests-integration/projects/*/cache
/crates/tests-integration/projects/*/*/out
/crates/tests-integration/projects/*/*/cache
